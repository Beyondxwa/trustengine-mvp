{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/guard_shell.py",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/secret_scan.py",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/verify_gate.py",
        "timeout": 900,
        "loop_limit": 3,
        "failClosed": false
      }
    ]
  }
}
